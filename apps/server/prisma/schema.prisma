generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Ticket {
  id              String   @id @default(cuid())
  role            String
  project         String
  title           String
  spec            String
  status          String   @default("queued")
  parentTicketId  String?
  sessionId       String?
  worktreePath    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastHeartbeatAt DateTime?
  // 기존 설치(이미 티켓/직원이 있는 DB)에서도 db push가 데이터 유실 없이 되도록 nullable로 둔다.
  // 실제로는 서버 부팅 시 기본 팀을 만들고 null인 행을 채워 넣어서 사실상 항상 값이 있게 유지한다.
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])
  // QA 직원이 이 티켓을 몇 번 반려했는지. 3회 넘게 반복되면 사람에게 승인을 요청한다(needs_approval).
  qaCycles        Int      @default(0)
  // QA가 남긴 가장 최근 반려 사유 - 원래 담당 직원의 다음 시도 프롬프트 맨 앞에 붙는다.
  qaNote          String?
}

// 여러 팀을 만들 수 있게 하기 위한 모델. 팀마다 팀장 세션(대화)과 직원 명단이 분리된다 -
// 팀장 프롬프트(agents/manager.md) 자체는 팀마다 다르지 않고, 그 팀장이 보는 직원/티켓 범위만 다르다.
model Team {
  id            String        @id @default(cuid())
  name          String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employees     Employee[]
  tickets       Ticket[]
  planningDocs  PlanningDoc[]
  memoryEntries MemoryEntry[]
}

// 팀장의 ask_user MCP 툴이 남기는 질문. 4단계 UI가 붙기 전까지는
// 여기 쌓인 걸 GET /questions 로 확인하고 사람이 수동으로 답한다.
model Question {
  id        String   @id @default(cuid())
  text      String
  status    String   @default("open") // open | answered
  answer    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 웹에서 추가/삭제하는 직원. 팀장(manager)은 agents/manager.md 파일 하나로 고정이라 여기 없다 -
// 이건 "여러 명 있을 수 있고, 이름으로 구분되고, 사용자가 자유롭게 늘리고 줄이는" 직원만을 위한 테이블.
// 시스템 프롬프트는 저장하지 않고 taskDescription으로부터 매번 생성한다 (runner의 buildEmployeePrompt).
model Employee {
  id              String   @id @default(cuid())
  name            String   @unique // 티켓의 role 값으로 그대로 쓰인다
  driver          String // claude | gemini | codex
  model           String?
  taskDescription String // 팀장이 위임 판단에 쓰는 자유 텍스트 ("puppynote-server 백엔드 담당" 등)
  allowedTools    String[]
  requireApproval String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Ticket.teamId와 같은 이유로 nullable (기존 설치 마이그레이션 안전성) - 부팅 시 자동으로 채워진다.
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])
}

// 직원 간 비동기 질문-답변 (팀장을 거치지 않는 사소한 소통). 보낸 쪽은 답을 기다리지 않고 계속
// 작업하고, 받는 쪽은 자기 다음 티켓 실행 시작 시점에 미답변 질문을 시스템 프롬프트에서 확인한다.
model PeerMessage {
  id        String   @id @default(cuid())
  fromName  String
  toName    String
  question  String
  answer    String?
  status    String   @default("open") // open | answered
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 채팅창의 "기획" 모드로 만든 서비스 기획서. 팀장이 기획 담당 직원에게 위임해서 만들고,
// 사람이 검토 후 승인하면 그 내용을 바탕으로 팀장이 실제 개발 티켓들을 발행한다.
model PlanningDoc {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  employeeName String // 기획을 맡은 직원 이름
  request      String // 사용자의 원래 요청
  content      String? // 완성된 기획서 (작성 중엔 null)
  status       String   @default("drafting") // drafting | review | approved | rejected
  // 기획자와의 대화(티키타카)를 이어가기 위한 Claude 세션 id. review 상태에서 수정 요청을
  // 보내면 이 세션을 --resume해서 새 초안을 이어서 쓴다 - 매번 새로 쓰는 게 아니다.
  sessionId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 팀장의 "과거에 뭘 했는지" 기억. 완료된 티켓/기획서를 임베딩해서 저장해두고, 팀장이
// search_history MCP 툴로 의미 검색을 한다 (정확한 id를 몰라도 "즐겨찾기 관련 작업 뭐 있었지"
// 같은 질문이 가능). Prisma가 vector 타입을 직접 다루지 못해 Unsupported로 선언하고
// 실제 읽기/쓰기는 raw SQL로 한다 (apps/server/src/memory/store.ts).
model MemoryEntry {
  id         String                      @id @default(cuid())
  teamId     String
  team       Team                        @relation(fields: [teamId], references: [id])
  sourceType String // "ticket" | "planning_doc"
  sourceId   String
  content    String // 임베딩에 쓴 원문 - 검색 결과에도 그대로 보여준다
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                    @default(now())

  @@unique([sourceType, sourceId])
}
