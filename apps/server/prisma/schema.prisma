generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Ticket {
  id              String   @id @default(cuid())
  role            String
  project         String
  title           String
  spec            String
  status          String   @default("queued")
  parentTicketId  String?
  sessionId       String?
  // 작업이 실제로 진행된 프로젝트의 그 시점 브랜치 이름(참고용) - 격리된 워크트리/새 브랜치 없이
  // 프로젝트 실제 폴더의 현재 브랜치에 직접 작업하므로 별도 병합 대상 브랜치는 없다.
  branch          String?
  // 작업 시작 시점의 HEAD 커밋 - diffSummary(실제 커밋 여부) 계산 기준점.
  baseSha         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastHeartbeatAt DateTime?
  // 기존 설치(이미 티켓/직원이 있는 DB)에서도 db push가 데이터 유실 없이 되도록 nullable로 둔다.
  // 실제로는 서버 부팅 시 기본 팀을 만들고 null인 행을 채워 넣어서 사실상 항상 값이 있게 유지한다.
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])
  // QA 직원이 이 티켓을 몇 번 반려했는지. 3회 넘게 반복되면 사람에게 승인을 요청한다(needs_approval).
  qaCycles        Int      @default(0)
  // 팀장이 티켓 생성 시 결정하는 QA 검증 필요 여부. 팀에 QA 직원이 있어도 false면 QA 세션을
  // 건너뛰고 바로 완료된다 - 모든 티켓이 QA를 거치면 간단한 작업에도 세션이 하나씩 더 돌아
  // 사용량이 크게 소모돼서, 위험한 변경만 선별해 검증하게 한다. 기본 true(기존 동작 유지).
  needsQa         Boolean  @default(true)
  // QA가 남긴 가장 최근 반려 사유 - 원래 담당 직원의 다음 시도 프롬프트 맨 앞에 붙는다.
  qaNote          String?
  // 직원 세션이 마지막으로 남긴 최종 보고 텍스트(커밋 여부와 무관하게 항상 저장) - 승인 전에
  // 사람이 raw 로그를 뒤지지 않고 바로 읽을 수 있게 검수 화면에 그대로 보여준다.
  resultText      String?
  // 이 티켓 브랜치에 실제로 커밋된 변경사항 요약(예: "커밋 2개, 3개 파일 변경(+45/-12)" 또는
  // "커밋 없음 - 변경사항이 반영되지 않습니다"). 승인 버튼을 눌러도 커밋이 없으면 머지해도
  // 실제로는 아무 코드도 반영되지 않는 사고("승인눌렀는데 코드가 없어")를 막기 위해 둔다.
  diffSummary     String?
  // 팀장이 사용량 제한으로 판단해 예약한 자동 재시작 시각/사유.
  retryAt         DateTime?
  retryReason     String?
  retryCount      Int      @default(0)
}

// 여러 팀을 만들 수 있게 하기 위한 모델. 팀마다 팀장 세션(대화)과 직원 명단이 분리된다 -
// 팀장 프롬프트(agents/manager.md) 자체는 팀마다 다르지 않고, 그 팀장이 보는 직원/티켓 범위만 다르다.
model Team {
  id            String        @id @default(cuid())
  name          String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  employees     Employee[]
  tickets       Ticket[]
  planningDocs  PlanningDoc[]
  memoryEntries MemoryEntry[]
  chatMessages  ChatMessage[]
  chatSessions  ChatSession[]
  // 이 팀이 담당하는 프로젝트 이름(WORKSPACE_ROOT 아래) 또는 절대경로 목록. 팀장 호출 시
  // 시스템 프롬프트에 그대로 박아 넣어서, list_projects MCP 툴 연결 여부와 무관하게 팀장이
  // 자기 담당 프로젝트를 확실히 알 수 있게 한다 (선택 입력 - 비워두면 기존처럼 동작).
  projects      String[]      @default([])
}

// 팀장과의 대화 한 덩어리. "세션 종료"를 누르기 전까지는 계속 같은 세션에 메시지가 쌓인다.
// 종료되면(endedAt 채워짐) 그 대화 전체가 요약되어 벡터 메모리(MemoryEntry)에 저장되고 -
// search_history로 "예전에 뭐 했었지" 같은 질문에 참고할 수 있다 - 다음 메시지부터는
// 새 세션이 만들어진다. 지난 세션 목록/기록은 웹 UI에서 계속 조회할 수 있다(지우지 않음).
model ChatSession {
  id        String        @id @default(cuid())
  teamId    String
  team      Team          @relation(fields: [teamId], references: [id])
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  messages  ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  teamId    String
  team      Team        @relation(fields: [teamId], references: [id])
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id])
  role      String // "user" | "manager"
  text      String
  createdAt DateTime    @default(now())
}

// 팀장의 ask_user MCP 툴이 남기는 질문. 4단계 UI가 붙기 전까지는
// 여기 쌓인 걸 GET /questions 로 확인하고 사람이 수동으로 답한다.
model Question {
  id        String   @id @default(cuid())
  text      String
  status    String   @default("open") // open | answered
  answer    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 웹에서 추가/삭제하는 직원. 팀장(manager)은 agents/manager.md 파일 하나로 고정이라 여기 없다 -
// 이건 "여러 명 있을 수 있고, 이름으로 구분되고, 사용자가 자유롭게 늘리고 줄이는" 직원만을 위한 테이블.
// 시스템 프롬프트는 저장하지 않고 taskDescription으로부터 매번 생성한다 (runner의 buildEmployeePrompt).
model Employee {
  id              String   @id @default(cuid())
  // 티켓의 role 값으로 그대로 쓰인다. 전역이 아니라 팀 안에서만 유일하다(@@unique 참고) -
  // 직원은 팀별로 관리되므로 다른 팀에 같은 이름("백엔드" 등)이 있는 게 정상이다. 따라서 이름으로
  // 직원을 찾을 때는 반드시 teamId와 함께 찾아야 한다(getEmployeeByName).
  name            String
  driver          String // claude | gemini | codex
  model           String?
  taskDescription String // 팀장이 위임 판단에 쓰는 자유 텍스트 ("puppynote-server 백엔드 담당" 등)
  // 이 직원이 담당하는 프로젝트(Team.projects 중 웹 UI에서 체크한 것들). 팀장이 담당 아닌
  // 직원에게 티켓을 만들면 서버가 거부한다(routes/tickets.ts). Team.projects와 같은 이유로
  // @default([])를 둔다 - 기존 직원 행이 db push에서 살아남고, 빈 배열은 "팀의 모든 프로젝트
  // 담당"(제약 없음)을 뜻해서 이 필드가 생기기 전 직원들이 그대로 동작한다.
  projects        String[] @default([])
  allowedTools    String[]
  requireApproval String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Ticket.teamId와 같은 이유로 nullable (기존 설치 마이그레이션 안전성) - 부팅 시 자동으로 채워진다.
  teamId          String?
  team            Team?    @relation(fields: [teamId], references: [id])

  // 이름은 팀 안에서만 유일하다. 다른 팀에는 같은 이름의 직원이 있어도 된다.
  @@unique([teamId, name])
}

// 직원 간 비동기 질문-답변 (팀장을 거치지 않는 사소한 소통). 보낸 쪽은 답을 기다리지 않고 계속
// 작업하고, 받는 쪽은 자기 다음 티켓 실행 시작 시점에 미답변 질문을 시스템 프롬프트에서 확인한다.
model PeerMessage {
  id        String   @id @default(cuid())
  // 직원 이름은 팀 안에서만 유일하므로 이름만으로는 누구인지 특정되지 않는다 - 어느 팀 안에서
  // 오간 대화인지 함께 저장해야 다른 팀의 동명이인에게 질문이 새지 않는다. 기존 행을 위해
  // nullable로 두고, 조회 시 teamId가 없는 옛 행은 이름만으로 매칭한다.
  teamId    String?
  fromName  String
  toName    String
  question  String
  answer    String?
  status    String   @default("open") // open | answered
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 채팅창의 "기획" 모드로 만든 서비스 기획서. 팀장이 기획 담당 직원에게 위임해서 만들고,
// 사람이 검토 후 승인하면 그 내용을 바탕으로 팀장이 실제 개발 티켓들을 발행한다.
model PlanningDoc {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id])
  employeeName String // 기획을 맡은 직원 이름
  request      String // 사용자의 원래 요청
  content      String? // 완성된 기획서 (작성 중엔 null)
  status       String   @default("drafting") // drafting | review | approved | rejected
  // 기획자와의 대화(티키타카)를 이어가기 위한 Claude 세션 id. review 상태에서 수정 요청을
  // 보내면 이 세션을 --resume해서 새 초안을 이어서 쓴다 - 매번 새로 쓰는 게 아니다.
  sessionId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 팀장의 "과거에 뭘 했는지" 기억. 완료된 티켓/기획서를 임베딩해서 저장해두고, 팀장이
// search_history MCP 툴로 의미 검색을 한다 (정확한 id를 몰라도 "즐겨찾기 관련 작업 뭐 있었지"
// 같은 질문이 가능). Prisma가 vector 타입을 직접 다루지 못해 Unsupported로 선언하고
// 실제 읽기/쓰기는 raw SQL로 한다 (apps/server/src/memory/store.ts).
model MemoryEntry {
  id         String                      @id @default(cuid())
  teamId     String
  team       Team                        @relation(fields: [teamId], references: [id])
  sourceType String // "ticket" | "planning_doc"
  sourceId   String
  content    String // 임베딩에 쓴 원문 - 검색 결과에도 그대로 보여준다
  embedding  Unsupported("vector(384)")?
  createdAt  DateTime                    @default(now())

  @@unique([sourceType, sourceId])
}
